# ============================================
# AI Chat CLI 配置文件
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# AI 提供商: deepseek
PROVIDER=deepseek

# API 密钥
API_KEY=sk-你的key放这里

# 覆盖默认 API 地址（一般不需要改）
# BASE_URL=https://api.deepseek.com/v1

# 模型选择（不填则用默认模型）
# DeepSeek: deepseek-chat | deepseek-coder
MODEL=deepseek-chat

# 生成参数（可选）
# TEMPERATURE=0.7    # 0-2，越高越有创意
# MAX_TOKENS=4096    # 单次回复最大 Token 数
