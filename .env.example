# ============================================
#  Egg Chat 环境变量配置示例
#  复制此文件为 .env 并填入你的真实配置
# ============================================

# API 提供商 (目前支持: deepseek)
PROVIDER=deepseek

# API Key (必填！)
# DeepSeek 平台申请: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# 模型选择 (可选，默认 deepseek-v4-flash)
# 可选: deepseek-v4-pro, deepseek-v4-flash
MODEL=deepseek-v4-flash

# 温度参数 (可选，0-1，默认 0.7)
# 越高越有创造性，越低越精确
TEMPERATURE=0.7

# 最大输出 token 数 (可选，默认 2048)
MAX_TOKENS=2048

# 端口 (可选，默认 3000)
PORT=3000
