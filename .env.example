# ============================================
# AI Chat CLI 配置文件
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# 选择 AI 提供商: deepseek | openai | zhipu | qwen
PROVIDER=deepseek

# API 密钥（通用 Key，所有平台适用）
API_KEY=sk-你的key放这里

# 也可以用平台专属 Key（优先级更高）
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ZHIPU_API_KEY=xxx
# QWEN_API_KEY=sk-xxx

# 覆盖默认 API 地址（一般不需要改）
# BASE_URL=https://api.deepseek.com/v1

# 模型选择（不填则用各平台默认模型）
# DeepSeek: deepseek-chat | deepseek-coder
# OpenAI:   gpt-4o | gpt-4o-mini | gpt-4-turbo | gpt-3.5-turbo
# 智谱:     glm-4-flash | glm-4 | glm-4-plus
# 通义千问: qwen-turbo | qwen-plus | qwen-max
MODEL=deepseek-chat

# 生成参数（可选）
# TEMPERATURE=0.7    # 0-2，越高越有创意
# MAX_TOKENS=4096    # 单次回复最大 Token 数
